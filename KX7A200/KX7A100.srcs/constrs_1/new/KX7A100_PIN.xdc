set_property -dict {PACKAGE_PIN F4 IOSTANDARD LVCMOS25} [get_ports {ow_SMG_DIG[7]}]

set_property -dict {PACKAGE_PIN W4 IOSTANDARD LVCMOS25} [get_ports {ow_SMG_SEL[0]}]
set_property -dict {PACKAGE_PIN V5 IOSTANDARD LVCMOS25} [get_ports {ow_SMG_SEL[1]}]
################################ KEY_pin ################################
set_property -dict {PACKAGE_PIN J16 IOSTANDARD LVCMOS15} [get_ports iw_KEY_PIN]
################################ PHYA ################################
set_property -dict {PACKAGE_PIN U21 IOSTANDARD LVCMOS15} [get_ports phy_rst_o]
### -----------------RX------------------###
set_property -dict {PACKAGE_PIN V4 IOSTANDARD LVCMOS25} [get_ports PHYA_rgmii_rxc]
set_property -dict {PACKAGE_PIN R6 IOSTANDARD LVCMOS25} [get_ports PHYA_rgmii_rx_ctl]
set_property -dict {PACKAGE_PIN T6 IOSTANDARD LVCMOS25} [get_ports {PHYA_rgmii_rxd[0]}]
