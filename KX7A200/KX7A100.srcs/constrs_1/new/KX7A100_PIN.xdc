create_clock -period 20.000 -name iw_SYS_CLK -waveform {0.000 10.000} [get_ports iw_SYS_CLK]

create_generated_clock -name clk_div_0 -source [get_pins mclk_rst_module_inst/clk_div_module_inst0/iw_sys_clk] -divide_by 4 [get_pins mclk_rst_module_inst/clk_div_module_inst0/clk_div]
create_generated_clock -name clk_div_1 -source [get_pins mclk_rst_module_inst/clk_div_module_inst1/iw_sys_clk] -divide_by 2 [get_pins mclk_rst_module_inst/clk_div_module_inst1/clk_div]
