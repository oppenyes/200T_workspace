################################ NET - IOSTANDARD ################################
set_property CFGBVS GND [current_design]
set_property CONFIG_VOLTAGE 1.5 [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLUP [current_design]
set_property BITSTREAM.GENERAL.COMPRESS true [current_design]
################################ SPI Configurate Setting ################################
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 33 [current_design]
################################ clock and reset define ################################
set_property -dict {PACKAGE_PIN J19 IOSTANDARD LVCMOS15} [get_ports iw_SYS_CLK]

set_property -dict {PACKAGE_PIN D17 IOSTANDARD LVCMOS15} [get_ports {io_CLK[0]}]
set_property -dict {PACKAGE_PIN C18 IOSTANDARD LVCMOS15} [get_ports {io_CLK[1]}]
################################ usb uart define ################################
set_property -dict {PACKAGE_PIN F21 IOSTANDARD LVCMOS15} [get_ports iw_UART_RX]
set_property -dict {PACKAGE_PIN F15 IOSTANDARD LVCMOS15} [get_ports ow_UART_TX]
################################ EEPROM IIC define ################################
set_property -dict {PACKAGE_PIN L6 IOSTANDARD LVCMOS25} [get_ports ow_EEPROM_IIC_SCL]
set_property -dict {PACKAGE_PIN M5 IOSTANDARD LVCMOS25} [get_ports io_EEPROM_IIC_SDA]
################################ LED_pin ################################
set_property -dict {PACKAGE_PIN P6 IOSTANDARD LVCMOS25} [get_ports ow_LED_PIN]
set_property -dict {PACKAGE_PIN Y17 IOSTANDARD LVCMOS33} [get_ports ow_WS2812B]
################################ SMG_pin ################################
set_property -dict {PACKAGE_PIN M6 IOSTANDARD LVCMOS25} [get_ports {ow_SMG_DIG[0]}]
set_property -dict {PACKAGE_PIN T3 IOSTANDARD LVCMOS25} [get_ports {ow_SMG_DIG[1]}]
set_property -dict {PACKAGE_PIN K2 IOSTANDARD LVCMOS25} [get_ports {ow_SMG_DIG[2]}]
